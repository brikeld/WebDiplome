{
  "name": "dystopian-social-score",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_API_ORIGIN=\"http://localhost:3001\" VITE_GENERATE_API_ORIGIN=\"http://localhost:3010\" vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js",
    "server:generate": "node server-generate.js",
    "worker:ai": "node worker/ai-worker.js",
    "servers": "concurrently -n data,gen -c cyan,magenta \"node server.js\" \"node server-generate.js\"",
    "dedupe:uploads": "node scripts/dedupe-uploads.js",
    "test": "vitest run",
    "deploy:api": "fly deploy",
    "deploy:web": "fly deploy --config fly.web.toml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "sharp": "^0.34.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lenis": "^1.3.23",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.6"
  }
}
